# all files
*

# .gitignore
!.gitignore

# CI
!.github/
!.github/workflows/
!.github/workflows/*.yml

# bootstrap
# The `*` above ignores every level, so each directory needs its own negation:
# without `!bootstrap/steps/` git never descends into it and `!bootstrap/steps/*`
# is never consulted.
!bootstrap/
!bootstrap/*
!bootstrap/steps/
!bootstrap/steps/*
!bootstrap/test/
!bootstrap/test/*
!bootstrap/tool/
!bootstrap/tool/*

# manual
# The HTML manual is the detailed one; bootstrap/MANUAL.md is the terminal
# cheatsheet. Tracked so a fresh clone can read it before anything is installed.
!manual/
!manual/*

# zsh
!zsh/
!zsh/.zshenv
!zsh/.zshrc
!zsh/aliases.zsh

# sheldon
!sheldon/
!sheldon/plugins.toml


# nvim
# lazy-lock.json is the single most valuable pin in this repo: without it a fresh
# machine clones HEAD of all ~35 plugins instead of the revisions that are known
# to work together. bootstrap replays it with `nvim --headless '+Lazy! restore'`.
!nvim/
!nvim/lazy-lock.json
!nvim/init.lua
!nvim/lua/
!nvim/lua/*
!nvim/lua/config/
!nvim/lua/config/*
!nvim/lua/config/plugins/
!nvim/lua/config/plugins/*

# tmux
!tmux/
!tmux/tmux.conf

# README
!README.md


# yt-dlp
!yt-dlp/
!yt-dlp/*

# git
# config.local itself stays untracked -- it holds the real address and signing
# key. Only the template is tracked, and bootstrap copies it into place.
!git/
!git/config
!git/config.local.template
!git/ignore
