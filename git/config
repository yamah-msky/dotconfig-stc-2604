[user]
	name = yamah-msky
	email = github2@mbmsky.dev
  signingkey = ~/.ssh/id_ed25519_github_sign.pub
  useConfigOnly = true

[gpg]
  format = ssh

[gpg "ssh"]
  allowedSignersFile = $HOME/.config/git/allowed_signers

[commit]
  gpgsign = true

[tag]
  gpgSign = true

[core]
  autocrlf = false
  eol = lf

[init]
	defaultBranch = main

[url "git@github.com:"]
  insteadOf = https://github.com/

[include]
  path = $HOME/.config/git/config.local
[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
